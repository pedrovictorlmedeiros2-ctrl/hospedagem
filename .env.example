# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: restrict slash-command registration to one guild during development
# (instant propagation vs up to 1h for global commands).
DISCORD_DEV_GUILD_ID=

# --- Database ---
# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/football_game
DATABASE_URL=

# --- Groq (narrative layer only — never authorized to write to the database) ---
GROQ_API_KEY=

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
